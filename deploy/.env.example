# Copy to deploy/.env on the server and fill in. Never commit the real file.
#
# Generate every secret below with (a guessed admin password is the easiest way in):
#   openssl rand -base64 32

DOMAIN=203-0-113-10.sslip.io          # your server's IP with dashes + .sslip.io, or your own domain
POSTGRES_PASSWORD=
FORGETME_ENCRYPTION_KEY=              # must be exactly 32 bytes, base64-encoded
FORGETME_HASH_SECRET=
FORGETME_ADMIN_PASSWORD=             # long and random: there is no password reset
